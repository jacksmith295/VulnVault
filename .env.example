# Local development only. These credentials match compose.yaml.
DATABASE_URL=postgresql://vulnvault:vulnvault@localhost:5432/vulnvault
BETTER_AUTH_URL=http://localhost:3000
# Replace with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=VulnVault <noreply@vulnvault.local>

# Used only by tests, never as the application's database.
TEST_DATABASE_URL=postgresql://vulnvault_test:vulnvault_test_only@127.0.0.1:55433/vulnvault_test

# Optional GitHub App integration. Keep the PEM outside this repository.
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/github-app.pem
